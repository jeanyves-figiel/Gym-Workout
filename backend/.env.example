# Required in production
NODE_ENV=production
JWT_SECRET=            # ≥ 32 random chars: openssl rand -base64 48
CODE_PEPPER=           # random secret for hashing email codes
SMTP_URL=              # smtps://user:pass@smtp.example.com:465
MAIL_FROM="Gym-Workout <no-reply@example.com>"
APPLE_BUNDLE_IDS=ch.figiel.gymworkout,ch.figiel.gymworkout.staging,ch.figiel.gymworkout.dev
# Optional
DB_PATH=/data/app.db
ACCESS_TTL_SEC=900
REFRESH_TTL_DAYS=60
AUTH_RATE_LIMIT_PER_MIN=10
