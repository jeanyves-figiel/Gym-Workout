# Required in production
NODE_ENV=production
JWT_SECRET=            # ≥ 32 random chars: openssl rand -base64 48
CODE_PEPPER=           # random secret for hashing email codes
SMTP_URL=              # smtps://user:pass@smtp.example.com:465
MAIL_FROM="MonkeyWorkout <no-reply@example.com>"
APPLE_BUNDLE_IDS=Com.app.MonkeyWorkout,Com.app.MonkeyWorkout.dev
# Optional
DB_PATH=/data/app.db
ACCESS_TTL_SEC=900
REFRESH_TTL_DAYS=60
AUTH_RATE_LIMIT_PER_MIN=10
# Sign in with Apple server-to-server (code exchange at sign-in, token revocation at account deletion).
# TEAM_ID + KEY_ID + PRIVATE_KEY all required, otherwise skipped (logged once).
# KEY_ID: "Sign in with Apple" key (developer.apple.com → Keys); PRIVATE_KEY: AuthKey_<KEY_ID>.p8 contents (newlines or \n).
# CLIENT_ID: fallback client_id; the identity token audience (bundle id) is used when known.
APPLE_TEAM_ID=U7VAR53G86
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_CLIENT_ID=Com.app.MonkeyWorkout
# Breached-password check (Have I Been Pwned k-anonymity): default on (off in tests), 0 disables.
HIBP_CHECK=1
# Purge of expired codes / refresh tokens, minutes (also at startup; 0 = startup only).
PURGE_INTERVAL_MIN=60
