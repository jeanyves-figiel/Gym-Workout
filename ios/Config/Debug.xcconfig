// DEV: local API (cd backend && npm run dev). `/$()/` escapes the xcconfig comment marker.
// Separate bundle id so DEV installs side by side with the TestFlight/App Store build.
APP_BUNDLE_ID = Com.app.MonkeyWorkout.dev
APP_DISPLAY_NAME = Monkey DEV
API_BASE_URL = http:/$()/localhost:7443
// App Group shared by the Watch app and its complications (#190).
APP_GROUP = group.$(APP_BUNDLE_ID)
// Over-the-air config signature (#583): base64 raw Ed25519 public key from the "Content signing key" workflow; empty → not checked.
CONTENT_PUBLIC_KEY =
