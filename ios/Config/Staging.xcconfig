// Staging build, distributed via TestFlight under the App Store Connect record (Apple ID 6819971090).
// Same bundle id as Release; points at the staging API on Fly.io (#3, backend/fly.staging.toml).
APP_BUNDLE_ID = Com.app.MonkeyWorkout
APP_DISPLAY_NAME = MonkeyFit
API_BASE_URL = https:/$()/workout-staging.monkeygrade.cloud
// App Group shared by the Watch app and its complications (#190).
APP_GROUP = group.$(APP_BUNDLE_ID)
